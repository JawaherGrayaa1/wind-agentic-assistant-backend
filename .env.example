AGENT_PLANNER=ollama
DATABASE_PATH=data/erp_agent.db
# Relative paths are resolved from the repository root.
VOSK_MODEL_DIR=vosk-model
# Use http://127.0.0.1:11434 for local Ollama, or your ngrok URL for remote (e.g. Kaggle)
OLLAMA_BASE_URL=https://styling-visitor-recall.ngrok-free.dev
OLLAMA_MODEL=qwen3.8:27b
MAX_AGENT_STEPS=4

# WIND Invoice Extraction service
# The local Docker deployment exposes http://127.0.0.1:8000 by default.
# Remap the extractor to another host port if the ERP API also uses 8000.
INVOICE_EXTRACTOR_URL=http://127.0.0.1:8000
INVOICE_EXTRACTOR_TIMEOUT=180
INVOICE_EXTRACTOR_TOKEN=
INVOICE_EXTRACTOR_TENANT=wind-erp
INVOICE_EXTRACTOR_LAYOUT=auto
